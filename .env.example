ENVIRONMENT=local
PROJECT_NAME=Structured Data Extractor
VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/extractor
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=26214400

# LLM Configuration
LLM_EXTRACTION_MODEL=gemini/gemini-2.5-flash
LLM_CLASSIFIER_MODEL=gemini/gemini-2.5-flash
LLM_MAX_RETRIES=2

# Cost Reporting
COST_MODEL_TOKEN_PRICES_USD={"gemini/gemini-2.5-flash":{"input_token_price_usd":"0.0000003","output_token_price_usd":"0.0000025"},"gemini-2.5-flash":{"input_token_price_usd":"0.0000003","output_token_price_usd":"0.0000025"},"gpt-4.1-mini":{"input_token_price_usd":"0.0000004","output_token_price_usd":"0.0000016"},"openai/gpt-4.1-mini":{"input_token_price_usd":"0.0000004","output_token_price_usd":"0.0000016"},"claude-haiku-4.5":{"input_token_price_usd":"0.000001","output_token_price_usd":"0.000005"},"claude-haiku-4-5":{"input_token_price_usd":"0.000001","output_token_price_usd":"0.000005"},"anthropic/claude-haiku-4.5":{"input_token_price_usd":"0.000001","output_token_price_usd":"0.000005"},"anthropic/claude-haiku-4-5":{"input_token_price_usd":"0.000001","output_token_price_usd":"0.000005"}}

# API Keys (LiteLLM requires these depending on the model used)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Background Jobs (Arq)
ARQ_REDIS_URL=redis://localhost:6379
