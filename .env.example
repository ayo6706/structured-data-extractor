ENVIRONMENT=local
PROJECT_NAME=Structured Data Extractor
VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/extractor
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# LLM Configuration
LLM_EXTRACTION_MODEL=anthropic/claude-sonnet-4-6
LLM_CLASSIFIER_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_MAX_RETRIES=2

# API Keys (LiteLLM requires these depending on the model used)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Background Jobs (Arq)
ARQ_REDIS_URL=redis://localhost:6379
